{
    "name": "hatchyu/laravel-steward",
    "description": "Elegant CQRS primitives, request query parsing, and native JSON:API stewardship for Laravel.",
    "type": "library",
    "license": "MIT",
    "version": "dev-main",
    "keywords": [
        "laravel",
        "cqrs",
        "cqrs-core",
        "json-api",
        "steward",
        "query-parser",
        "actions",
        "queries",
        "dto"
    ],
    "autoload": {
        "psr-4": {
            "Hatchyu\\Steward\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hatchyu\\Steward\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/validation": "^12.0 || ^13.0",
        "hatchyu/laravel-api-exceptions": "^0.2.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpunit/phpunit": "^11.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hatchyu\\Steward\\StewardServiceProvider"
            ]
        }
    }
}
